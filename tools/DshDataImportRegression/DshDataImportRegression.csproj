<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RegressionSource Condition="'$(RegressionSource)' == ''">$(MSBuildThisFileDirectory)Program.cs</RegressionSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RegressionSource)" Link="Program.cs" />
    <Compile Include="../../src/DshInstaller/Shared/DshDataImportService.cs" Link="DshDataImportService.cs" />
  </ItemGroup>
</Project>
