<?xml version="1.0" encoding="utf-8"?>
<!--
  安装器的视觉令牌。
  品牌就是黑白两色,所以强调色 = 文字色:
    浅色模式 黑字黑底强调,深色模式自然反转成白色。
  颜色分 Light / Dark 两套,页面里一律用 ThemeResource 取,别写死色值。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============ 浅色:白底黑字 ============ -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="ShellBackgroundColor">#FFF6F6F7</Color>
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{StaticResource ShellBackgroundColor}" />

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#16000000" />

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF0F0F10" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5A5A5F" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF8A8A90" />

            <!-- 强调色 = 品牌黑 -->
            <Color x:Key="AccentColor">#FF111112</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#0F000000" />
            <!-- 压在强调色上的前景(黑底上要白字) -->
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#FF2E9E5B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFD98A00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFD64545" />

            <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PressedBrush" Color="#1C000000" />
        </ResourceDictionary>

        <!-- ============ 深色:黑底白字(自动反转) ============ -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ShellBackgroundColor">#FF131315</Color>
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{StaticResource ShellBackgroundColor}" />

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1C1C1F" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA9A9B0" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF77777E" />

            <Color x:Key="AccentColor">#FFF2F2F4</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#14FFFFFF" />
            <!-- 白底强调,前景要黑 -->
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FF111112" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CC47C" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFE0A33A" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFE06A6A" />

            <SolidColorBrush x:Key="DividerBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PressedBrush" Color="#24FFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ============ 与主题无关的度量 ============ -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>

    <x:Double x:Key="PageTitleFontSize">24</x:Double>
    <x:Double x:Key="PageSubtitleFontSize">12.5</x:Double>
    <x:Double x:Key="WelcomeTitleFontSize">30</x:Double>

</ResourceDictionary>
