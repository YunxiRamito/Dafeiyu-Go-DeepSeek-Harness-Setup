<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DshInstaller.Pages.ExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:DshInstaller.Controls"
      Background="Transparent">
    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Body" Spacing="12">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection><EntranceThemeTransition /><RepositionThemeTransition /></TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ModeTitle" FontSize="14" FontWeight="SemiBold" />
                    <RadioButton x:Name="OfficialMode" GroupName="ExportMode" Checked="OnModeChanged" />
                    <RadioButton x:Name="DymMode" GroupName="ExportMode" Checked="OnModeChanged" />
                    <TextBlock x:Name="ModeDescription" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SourceTitle" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="RootText" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <ComboBox x:Name="SourceChoices" HorizontalAlignment="Stretch" SelectionChanged="OnSourceChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceHomeBox" TextChanged="OnSourcePathChanged" LostFocus="OnSourceLostFocus" />
                        <Button x:Name="SourceFolderButton" Grid.Column="1" Click="OnSourceBrowse"><SymbolIcon Symbol="Folder" /></Button>
                        <Button x:Name="ReadSourceButton" Grid.Column="2" Click="OnReadSource"><SymbolIcon Symbol="Refresh" /></Button>
                    </Grid>
                    <TextBlock x:Name="SourceHint" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="GroupsTitle" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="GroupsDesc" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel x:Name="GroupsHost" Spacing="2">
                        <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition /><RepositionThemeTransition /></TransitionCollection></StackPanel.ChildrenTransitions>
                    </StackPanel>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TargetTitle" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetDirectoryBox" TextChanged="OnTargetChanged" />
                        <Button x:Name="FolderButton" Grid.Column="1" Click="FolderButton_Click"><SymbolIcon Symbol="Folder" /></Button>
                    </Grid>
                    <TextBlock x:Name="OutputPreview" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ExportButton" Click="ExportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Save" /><TextBlock x:Name="ExportButtonText" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="CancelExportButton" Visibility="Collapsed" Click="OnCancelExport">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Cancel" /><TextBlock x:Name="CancelButtonText" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="6">
                    <ProgressBar x:Name="ExportProgress" Height="6" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="ExportDetail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <InfoBar x:Name="StatusMessage" IsOpen="False" IsClosable="False" Severity="Error" />
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Spacing="6">
                    <TextBox x:Name="ResultPath" IsReadOnly="True" TextWrapping="Wrap" />
                    <Button x:Name="RevealButton" Click="OnReveal"><SymbolIcon Symbol="OpenFile" /></Button>
                </StackPanel>
                <CheckBox x:Name="SkipExportBox" Checked="OnSkipChanged" Unchecked="OnSkipChanged">
                    <TextBlock x:Name="SkipExportText" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock x:Name="ContinueHint" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </ScrollViewer>
    </controls:PageScaffold>
</Page>
