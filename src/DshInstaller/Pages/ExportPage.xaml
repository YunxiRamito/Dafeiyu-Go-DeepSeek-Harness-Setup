<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <StackPanel Spacing="12">

            <Border
                CornerRadius="{ThemeResource CardCornerRadius}"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="GroupsTitle"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="GroupsDesc"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel
                        x:Name="GroupsHost"
                        Spacing="6" />
                    <TextBlock
                        x:Name="EmptyText"
                        Visibility="Collapsed"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <Border
                CornerRadius="{ThemeResource CardCornerRadius}"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="TargetTitle"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="FolderButton"
                            Click="FolderButton_Click" />
                        <TextBlock
                            x:Name="TargetText"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="ExportButton"
                        Click="ExportButton_Click" />
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="ProgressPanel"
                Visibility="Collapsed"
                Spacing="8">
                <ProgressBar
                    x:Name="ExportProgress"
                    Height="6" />
                <TextBlock
                    x:Name="ExportDetail"
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                FontSize="12.5"
                TextWrapping="Wrap" />
        </StackPanel>
    </controls:PageScaffold>
</Page>
