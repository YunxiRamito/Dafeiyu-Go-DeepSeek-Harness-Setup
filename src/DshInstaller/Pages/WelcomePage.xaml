<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid
        Padding="28,16,28,12"
        HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 品牌区:保留鲸鱼标，产品字样切换为大肥鱼Go。 -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <Grid x:Name="MarkHost" HorizontalAlignment="Center" />
            <StackPanel x:Name="WordmarkHost" HorizontalAlignment="Center" Spacing="2">
                <TextBlock x:Name="WordmarkText"
                           HorizontalAlignment="Center"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}"
                           Text="大肥鱼Go" />
                <TextBlock x:Name="WordmarkEnglish"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="Dafeiyu-Go" />
            </StackPanel>
            <TextBlock x:Name="DescText"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- 说明卡片 -->
        <Border Grid.Row="1" CornerRadius="{ThemeResource CardCornerRadius}"
                Background="{ThemeResource CardBackgroundSubtleBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Padding="18,14">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TermsText" FontSize="12"
                           Foreground="{ThemeResource TertiaryTextBrush}" />
                <StackPanel x:Name="NotesHost" Spacing="6" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
