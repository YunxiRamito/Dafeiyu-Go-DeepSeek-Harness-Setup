<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="12">

            <!-- 第一步:挑一个备份包 -->
            <Border
                CornerRadius="{ThemeResource CardCornerRadius}"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="PickTitle"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="PickDesc"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DiscoverButton" Click="DiscoverButton_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="DiscoverDrivesButton" Click="DiscoverDrivesButton_Click" />
                    </StackPanel>
                    <Grid x:Name="DiscoveryProgressPanel" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="DiscoveryProgressRing" Width="20" Height="20" IsActive="False" />
                        <TextBlock x:Name="DiscoveryStatus" Grid.Column="1" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                        <Button x:Name="CancelDiscoveryButton" Grid.Column="2" Click="CancelDiscoveryButton_Click" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardDividerBrush}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PickButton"
                            HorizontalAlignment="Stretch"
                            Click="PickButton_Click" />
                        <Button x:Name="PickDshButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="PickDshButton_Click" />
                    </Grid>
                    <TextBlock x:Name="ArchiveText" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed" />
                    <ComboBox x:Name="DshProfileBox" Header="来源 Profile" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="DshProfileBox_SelectionChanged" />
                </StackPanel>
            </Border>

            <!-- 第二步:勾要恢复哪些(读包里的内容列出来) -->
            <Border
                x:Name="GroupsCard"
                Visibility="Collapsed"
                CornerRadius="{ThemeResource CardCornerRadius}"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="GroupsTitle"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <StackPanel
                        x:Name="GroupsHost"
                        Spacing="6" />
                    <TextBlock x:Name="DshImportSummary" TextWrapping="Wrap" FontSize="12.5" Visibility="Collapsed" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock
                        x:Name="ConflictLabel"
                        FontSize="12.5"
                        Foreground="{ThemeResource SecondaryTextBrush}" />
                    <ComboBox
                        x:Name="ConflictBox"
                        MinWidth="220"
                        HorizontalAlignment="Left" />
                    <Button
                        x:Name="ImportButton"
                        Content="开始导入"
                        Click="ImportButton_Click"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- 第三步:进度 -->
            <StackPanel
                x:Name="ProgressPanel"
                Visibility="Collapsed"
                Spacing="8">
                <ProgressBar
                    x:Name="ImportProgress"
                    Height="6" />
                <TextBlock
                    x:Name="ImportDetail"
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SecondaryTextBrush}" />
                <Button x:Name="CancelOfficialImportButton" Content="取消导入" Visibility="Collapsed" Click="CancelOfficialImportButton_Click" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                FontSize="12.5"
                TextWrapping="Wrap" />
        </StackPanel>
        </ScrollViewer>
    </controls:PageScaffold>
</Page>
