<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <StackPanel Spacing="12">

            <!-- DSH 本体:这条通道可以选版本 -->
            <Border
                CornerRadius="{ThemeResource CardCornerRadius}"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="DshTitle"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="DshDesc"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SecondaryTextBrush}" />
                    <ComboBox
                        x:Name="DshChannelBox"
                        MinWidth="280"
                        HorizontalAlignment="Left"
                        SelectionChanged="DshChannelBox_SelectionChanged" />
                    <TextBox
                        x:Name="DshVersionBox"
                        MinWidth="280"
                        HorizontalAlignment="Left"
                        IsEnabled="False" />
                    <TextBlock
                        x:Name="DshHint"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <!-- 启动器:通道先对齐,功能还没做 -->
            <Border
                CornerRadius="{ThemeResource CardCornerRadius}"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundSubtleBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="LauncherTitle"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="LauncherDesc"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <ComboBox
                            x:Name="LauncherVersionBox"
                            MinWidth="280"
                            IsEnabled="False" />
                        <Button
                            x:Name="LauncherApplyButton"
                            IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </controls:PageScaffold>
</Page>
