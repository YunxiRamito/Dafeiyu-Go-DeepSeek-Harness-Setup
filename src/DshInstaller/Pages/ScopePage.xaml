<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.ScopePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <StackPanel Spacing="12">
            <!-- 两张卡片在代码里造(SelectableCard) -->
            <StackPanel x:Name="CardsHost" Spacing="12" />

            <!-- 管理员提示,只在选了"为所有用户"时出现 -->
            <Border x:Name="AdminHint" Visibility="Collapsed"
                    CornerRadius="8" Padding="14,11"
                    Background="{ThemeResource AccentSoftBrush}">
                <!-- 必须用 Grid 而不是横向 StackPanel:
                     横向 StackPanel 给子元素的可用宽度是无穷大,wrapping 就永远不会生效,
                     英文这种更长的文案会直接溢出被裁(实测提示末尾的句号被切掉)。 -->
                <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7EF;" FontSize="13"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentBrush}" />
                    <TextBlock Grid.Column="1" x:Name="AdminHintText" FontSize="12.5"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </Grid>
            </Border>
        </StackPanel>
    </controls:PageScaffold>
</Page>
