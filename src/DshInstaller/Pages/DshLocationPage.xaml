<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.DshLocationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="14">
            <StackPanel x:Name="ExistingBox" Visibility="Collapsed" Spacing="10">
                <StackPanel.Transitions>
                    <TransitionCollection><EntranceThemeTransition /></TransitionCollection>
                </StackPanel.Transitions>
                <TextBlock x:Name="ExistingTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ExistingDescription" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                <ComboBox x:Name="InstallationBox" HorizontalAlignment="Stretch" SelectionChanged="OnInstallationChanged" />
                <StackPanel Spacing="4">
                    <RadioButton x:Name="ReuseButton" GroupName="DshChoice" Tag="reuse" Checked="OnChoiceChanged" />
                    <RadioButton x:Name="MigrateButton" GroupName="DshChoice" Tag="migrate" Checked="OnChoiceChanged" />
                    <RadioButton x:Name="FreshButton" GroupName="DshChoice" Tag="fresh" Checked="OnChoiceChanged" />
                </StackPanel>
                <Expander x:Name="MigrationOptions" Visibility="Collapsed" HorizontalAlignment="Stretch">
                    <TextBox x:Name="MigrationHomeBox" TextChanged="OnPathChanged" />
                </Expander>
            </StackPanel>

            <Border CornerRadius="{ThemeResource CardCornerRadius}"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="16,14">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PathLabel" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource SecondaryTextBrush}" />
                        <TextBox x:Name="PathBox" Grid.Column="1" Height="32"
                                 VerticalAlignment="Center" TextChanged="OnPathChanged" />
                        <Button x:Name="BrowseButton" Grid.Column="2" Height="32" MinWidth="76"
                                Click="OnBrowseClick" />
                    </Grid>

                    <TextBlock x:Name="HintText" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{ThemeResource TertiaryTextBrush}" />
                </StackPanel>
            </Border>

            <!-- 磁盘占用提示 -->
            <TextBlock x:Name="DiskHint" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{ThemeResource TertiaryTextBrush}" />
            <InfoBar x:Name="ValidationMessage" IsOpen="False" IsClosable="False" Severity="Error" />
        </StackPanel>
        </ScrollViewer>
    </controls:PageScaffold>
</Page>
