<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.SourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">
                <StackPanel x:Name="CardsHost" Spacing="12" />

                <!-- 代理:和下载源是两个独立的选择 —— 源决定"去哪儿下",代理决定"怎么连出去" -->
                <Border x:Name="ProxyBox" CornerRadius="{ThemeResource CardCornerRadius}"
                        Background="{ThemeResource CardBackgroundSubtleBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="14,11">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ProxyLabel" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" />

                        <!-- 选项在代码里加:文案要跟语言走,XAML 里写死就没法翻 -->
                        <RadioButtons x:Name="ProxyModeHost"
                                      SelectionChanged="OnProxyModeChanged" />

                        <StackPanel x:Name="ProxyDetailHost" Spacing="6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="ProxyProtocolBox" MinWidth="104"
                                          SelectionChanged="OnProxyDetailChanged" />
                                <TextBox x:Name="ProxyHostBox" MinWidth="180" Width="220"
                                         TextChanged="OnProxyDetailChanged" />
                                <TextBox x:Name="ProxyPortBox" Width="86"
                                         TextChanged="OnProxyDetailChanged" />
                            </StackPanel>
                            <TextBlock x:Name="ProxyPortHint" FontSize="10.5"
                                       Foreground="{ThemeResource TertiaryTextBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="ProxyHint" FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TertiaryTextBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="Footnote"
                    Margin="4,2,4,0"
                    FontSize="11.5"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </controls:PageScaffold>
</Page>
