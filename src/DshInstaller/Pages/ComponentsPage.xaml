<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.ComponentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <controls:PageScaffold x:Name="Scaffold" Title="" Subtitle="">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 组件根目录 + 下载源 -->
            <Border Grid.Row="0" CornerRadius="{ThemeResource CardCornerRadius}"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="14,11">
                <Grid ColumnSpacing="10" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="RootLabel" Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBox x:Name="RootBox" Grid.Row="0" Grid.Column="1"
                             Height="30" VerticalAlignment="Center" />
                    <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="2"
                            Height="30" MinWidth="72"
                            Click="OnBrowseClick" />

                    <!-- "仅为本用户安装"却选了个要管理员权限的目录时在这里提醒(平时收起来) -->
                    <TextBlock x:Name="ElevationHint" Grid.Row="1" Grid.ColumnSpan="3"
                               FontSize="11.5" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!--
              必选在左、可选在右,两列并排 —— 这样所有组件在**一屏之内**都看得见。

              曾经竖着排(必选卡片在上、可选在下),结果必选卡片自己带滚动条,
              把"可选"整块顶到窗口外面去了:用户根本不知道下面还有东西(实测反馈)。
              并排之后每列只有三四个条目,Auto 高度就够,不需要滚动。
              外面那层 ScrollViewer 只是兜底:条目再多或者窗口被拖小时不至于看不全。
            -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" Padding="0,0,6,0">
                <Grid ColumnSpacing="12" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="{ThemeResource CardCornerRadius}"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            Padding="14,10"
                            VerticalAlignment="Top">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="RequiredLabel" Grid.Row="0" FontSize="11"
                                       Foreground="{ThemeResource TertiaryTextBrush}" />

                            <StackPanel x:Name="RequiredHost" Grid.Row="1" Spacing="2" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="{ThemeResource CardCornerRadius}"
                            Background="{ThemeResource CardBackgroundSubtleBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            Padding="14,10"
                            VerticalAlignment="Top">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="OptionalLabel" Grid.Row="0" FontSize="11"
                                       Foreground="{ThemeResource TertiaryTextBrush}" />

                            <StackPanel x:Name="OptionalHost" Grid.Row="1" Spacing="2" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </controls:PageScaffold>
</Page>
