<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DshInstaller.Pages.DonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls"
    Background="Transparent">

    <Grid Padding="36,14,36,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="14">
            <!--
              完成标记:圆底 + 图标。
              全部成功 = 对勾;只有可选组件没装上 = 黄色感叹号(能用,只是提醒)。
              两种状态共用这一个圆底,靠代码换颜色和字形。
            -->
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse x:Name="BadgeOuter" Fill="{ThemeResource AccentSoftBrush}" />
                <Ellipse x:Name="BadgeInner" Width="46" Height="46"
                         Fill="{ThemeResource AccentBrush}" Opacity="0.9" />
                <FontIcon x:Name="BadgeIcon" Glyph="&#xE73E;" FontSize="22" Foreground="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="21" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock x:Name="SubtitleText"
                           FontSize="13" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>

            <!--
              摘要框撤了(用户点名要去掉):"完成 14 项 / DSH 本体 / 启动器 / 桌面快捷方式 已创建"
              这几行是给技术支持看的信息量,对用户只是噪音 —— 上面那句
              "DeepSeek Harness 现已可使用"已经把该说的说完了。
              容器留着(名字不变),代码照样往里填,只是不显示;哪天想加回来改这一行就行。
            -->
            <Border x:Name="SummaryBox" Visibility="Collapsed"
                    CornerRadius="{ThemeResource CardCornerRadius}"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="18,14"
                    MaxWidth="520"
                    HorizontalAlignment="Center">
                <StackPanel x:Name="SummaryHost" Spacing="8" />
            </Border>

            <!-- 只给"未完全完成"用:哪些可选组件没装上 -->
            <Border x:Name="PartialBox" CornerRadius="{ThemeResource CardCornerRadius}"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="18,12"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="PartialLabel" FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel x:Name="PartialHost" Spacing="3" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center">
            <CheckBox x:Name="LaunchBox" IsChecked="True" HorizontalAlignment="Center" />
            <TextBlock x:Name="FootnoteText" FontSize="11.5" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TertiaryTextBrush}" />
        </StackPanel>
    </Grid>
</Page>
