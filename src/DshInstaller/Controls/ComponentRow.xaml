<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DshInstaller.Controls.ComponentRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 一行组件:图标 + 名称 + 版本/说明 + 右侧状态。
         状态位可以在"圆点 / 进度环 / 对勾 / 叉"之间切。 -->
    <Grid x:Name="RootGrid" Padding="0,9" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 状态图标位 -->
        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
            <FontIcon x:Name="StateIcon" FontSize="14" Glyph="&#xE73E;"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource TertiaryTextBrush}" />
            <ProgressRing x:Name="Busy" Width="17" Height="17" IsActive="False"
                          Visibility="Collapsed"
                          Foreground="{ThemeResource AccentBrush}" />
        </Grid>

        <!-- 名称与说明 -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="NameText" FontSize="13.5"
                       Foreground="{ThemeResource PrimaryTextBrush}" />
            <TextBlock x:Name="DetailText" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{ThemeResource TertiaryTextBrush}" />
        </StackPanel>

        <!-- 右侧状态文字 -->
        <TextBlock x:Name="StateText" Grid.Column="2" FontSize="12"
                   VerticalAlignment="Center"
                   MaxWidth="150"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   TextAlignment="Right"
                   Foreground="{ThemeResource SecondaryTextBrush}" />
    </Grid>
</UserControl>
