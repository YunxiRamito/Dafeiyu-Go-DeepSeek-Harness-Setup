<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DshInstaller.Controls.PageScaffold"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DshInstaller.Controls">

    <!--
      内容收在居中一列里,窗口固定尺寸后不会把卡片拉成横带。
      页面 XAML 里写的子元素靠 [ContentProperty("Body")] 直接落到 BodyHost,
      不会变成 UserControl 自己的 Content(那样会把整个外框顶掉)。
    -->
    <Grid Padding="28,16,28,12">
        <!-- 居中 + 上限 600:窗口被 DPI 或小屏压窄时能自动收缩,不会横向裁掉内容 -->
                <Grid HorizontalAlignment="Stretch" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:StepIndicator x:Name="Steps" Grid.Row="0" />

            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock x:Name="TitleText"
                           FontSize="{ThemeResource PageTitleFontSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock x:Name="SubtitleText"
                           FontSize="{ThemeResource PageSubtitleFontSize}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>

            <ContentPresenter x:Name="BodyHost" Grid.Row="2" />
        </Grid>
    </Grid>
</UserControl>
