<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DshInstaller.Shared</RootNamespace>
    <AssemblyName>DshInstaller.Shared</AssemblyName>
    <Version>$(InstallerVersion)</Version>
    <AssemblyVersion>$(InstallerVersionFull)</AssemblyVersion>
    <FileVersion>$(InstallerVersionFull)</FileVersion>
    <Authors>$(Authors)</Authors>
    <Company>$(Company)</Company>
    <Product>DeepSeek Harness Installer</Product>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    .dym 备份包用的是**真 7z** 格式,所以要带一个 7z 工具。
    选 7zr.exe 的理由:588 KB,单文件、无依赖、公开领域(7-Zip 的 Igor Pavlov 释出),
    不需要额外挂第三方声明;而完整的 7z.dll + 包装层要多几百 KB 和一层 P/Invoke。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Backup\7zr.exe" />
  </ItemGroup>

</Project>
