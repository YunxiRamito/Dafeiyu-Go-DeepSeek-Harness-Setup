<Project>
  <PropertyGroup>
    <InstallerVersion>1.4.9</InstallerVersion>
    <InstallerVersionFull>1.4.9.0</InstallerVersionFull>
    <LauncherVersion>1.4.9</LauncherVersion>
    <DshPackage>@deepseek-ai/dsh</DshPackage>
    <DshPackageVersion>^0.1.5-rc.1</DshPackageVersion>
    <NodeLtsMajor>22</NodeLtsMajor>
    <NodeMinimumVersion>22.13.0</NodeMinimumVersion>
    <WindowsMinimumBuild>17763</WindowsMinimumBuild>
    <WindowsAppRuntimeVersion>1.8.260804001</WindowsAppRuntimeVersion>

    <!--
      产品信息 —— **属性页里显示的那些字全部来自这里**。

      主程序(.NET 项目)读的是下面这几个 MSBuild 属性;
      引导程序和卸载程序是 csc 直编的,读不了 MSBuild,
      由 pack-release.ps1 把同一批值生成为程序集特性再编进去。
      两边都指向这一份,免得又出现"安装器写着 A、卸载器写着 B"。

      Version 别用 1.0.0+<commit> 那种形式:属性页里那串 hash 很难看,
      要看 commit 去 Release 页面看。
    -->
    <Product>Dafeiyu-Go</Product>
    <AssemblyTitle>大肥鱼Go安装程序</AssemblyTitle>
    <Description>大肥鱼Go，面向 DeepSeek Harness 的一体化 Windows 安装程序</Description>
    <Company>Deepseek / KitamaruRamito</Company>
    <Copyright>Copyright © 2026 Deepseek / KitamaruRamito · MIT License</Copyright>
    <Version>$(InstallerVersion)</Version>
    <FileVersion>$(InstallerVersionFull)</FileVersion>

    <!--
      AssemblyVersion 也要在这里给:共享库自己也要报版本号
      (WellKnown.InstallerVersion 是从程序集读的,见那边的注释)。
      不给的话共享库默认 1.0.0.0,注册表里就会记成旧版本。
    -->
    <AssemblyVersion>$(InstallerVersionFull)</AssemblyVersion>
    <InformationalVersion>$(InstallerVersion)</InformationalVersion>

    <!-- 引导程序那份的标题(和主程序不同:一个是安装程序,一个是引导程序) -->
    <BootTitle>大肥鱼Go安装程序</BootTitle>
    <BootDescription>大肥鱼Go，面向 DeepSeek Harness 的一体化 Windows 安装程序</BootDescription>
    <UninstallTitle>大肥鱼Go卸载程序</UninstallTitle>
    <UninstallDescription>卸载大肥鱼Go以及它装上的 DeepSeek Harness 组件</UninstallDescription>

    <Authors>Deepseek/KitamaruRamito</Authors>
  </PropertyGroup>
</Project>
